require 'jwt'
require 'net/http'
require 'uri'
require 'json'
require 'openssl'

default_platform(:ios)

def get_asc_token(key_id, issuer_id, private_key_pem)
  header = { alg: "ES256", kid: key_id, typ: "JWT" }
  payload = { iss: issuer_id, exp: Time.now.to_i + (20 * 60), aud: "appstoreconnect-v1" }
  ec_key = OpenSSL::PKey::EC.new(private_key_pem)
  JWT.encode(payload, ec_key, 'ES256', header)
end

def revoke_old_distribution_certs(key_id, issuer_id, private_key_pem)
  token = get_asc_token(key_id, issuer_id, private_key_pem)
  ["DISTRIBUTION", "IOS_DISTRIBUTION"].each do |cert_type|
    uri = URI("https://api.appstoreconnect.apple.com/v1/certificates?filter[certificateType]=#{cert_type}")
    req = Net::HTTP::Get.new(uri)
    req["Authorization"] = "Bearer #{token}"
    res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
    if res.is_a?(Net::HTTPSuccess)
      data = JSON.parse(res.body)
      certs = data["data"] || []
      certs.each do |c|
        c_id = c["id"]
        del_uri = URI("https://api.appstoreconnect.apple.com/v1/certificates/#{c_id}")
        del_req = Net::HTTP::Delete.new(del_uri)
        del_req["Authorization"] = "Bearer #{token}"
        Net::HTTP.start(del_uri.hostname, del_uri.port, use_ssl: true) { |http| http.request(del_req) }
        UI.message("Revoked old distribution cert: #{c_id}")
      end
    end
  end
end

def ensure_bundle_id_exists(key_id, issuer_id, private_key_pem, bundle_id, app_name)
  token = get_asc_token(key_id, issuer_id, private_key_pem)

  # List existing apps in ASC
  apps_uri = URI("https://api.appstoreconnect.apple.com/v1/apps")
  apps_req = Net::HTTP::Get.new(apps_uri)
  apps_req["Authorization"] = "Bearer #{token}"
  apps_res = Net::HTTP.start(apps_uri.hostname, apps_uri.port, use_ssl: true) { |http| http.request(apps_req) }
  if apps_res.is_a?(Net::HTTPSuccess)
    apps_data = JSON.parse(apps_res.body)
    existing_apps = (apps_data["data"] || []).map { |a| "#{a['attributes']['name']} (#{a['attributes']['bundleId']})" }
    UI.message("Existing Apps in App Store Connect: #{existing_apps.inspect}")
  end

  # Register Bundle ID if not exists
  uri = URI("https://api.appstoreconnect.apple.com/v1/bundleIds?filter[identifier]=#{bundle_id}")
  req = Net::HTTP::Get.new(uri)
  req["Authorization"] = "Bearer #{token}"
  res = Net::HTTP.start(uri.hostname, uri.port, use_ssl: true) { |http| http.request(req) }
  
  bundle_id_resource_id = nil
  if res.is_a?(Net::HTTPSuccess)
    data = JSON.parse(res.body)
    if data["data"] && data["data"].length > 0
      bundle_id_resource_id = data["data"][0]["id"]
      UI.message("Bundle ID already registered: #{bundle_id} (ID: #{bundle_id_resource_id})")
    end
  end

  unless bundle_id_resource_id
    post_uri = URI("https://api.appstoreconnect.apple.com/v1/bundleIds")
    post_req = Net::HTTP::Post.new(post_uri)
    post_req["Authorization"] = "Bearer #{token}"
    post_req["Content-Type"] = "application/json"
    post_req.body = JSON.dump({
      data: {
        type: "bundleIds",
        attributes: {
          identifier: bundle_id,
          name: app_name[0...25],
          platform: "UNIVERSAL"
        }
      }
    })
    post_res = Net::HTTP.start(post_uri.hostname, post_uri.port, use_ssl: true) { |http| http.request(post_req) }
    if post_res.is_a?(Net::HTTPSuccess) || post_res.code == "201"
      post_data = JSON.parse(post_res.body)
      bundle_id_resource_id = post_data["data"]["id"]
      UI.message("Successfully registered Bundle ID: #{bundle_id} (ID: #{bundle_id_resource_id})")
    else
      UI.important("Bundle ID registration response: #{post_res.code} - #{post_res.body}")
    end
  end
end

def attach_widget_extension_to_xcodeproj(team_id, widget_bundle_id, widget_profile_name)
  require 'xcodeproj'
  candidates = [
    "Runner.xcodeproj",
    "../Runner.xcodeproj",
    File.expand_path("../Runner.xcodeproj", __dir__),
    File.expand_path("Runner.xcodeproj", Dir.pwd)
  ]
  proj_path = candidates.find { |p| File.exist?(p) }
  raise "Runner.xcodeproj not found in #{candidates.inspect}" unless proj_path

  UI.message("Opening Xcode project at: #{proj_path}")
  project = Xcodeproj::Project.open(proj_path)

  runner_target = project.targets.find { |t| t.name == "Runner" }
  existing_widget = project.targets.find { |t| t.name == "HydroWidgets" }
  if existing_widget
    UI.message("HydroWidgets target already exists in Runner.xcodeproj, updating signing settings...")
    existing_widget.build_configurations.each do |config|
      config.build_settings["PRODUCT_BUNDLE_IDENTIFIER"] = widget_bundle_id
      config.build_settings["DEVELOPMENT_TEAM"] = team_id
      config.build_settings["CODE_SIGN_STYLE"] = "Manual"
      config.build_settings["CODE_SIGN_IDENTITY"] = "Apple Distribution"
      config.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = widget_profile_name
    end
    project.save
    return
  end

  UI.message("Creating HydroWidgets WidgetKit Extension target in Runner.xcodeproj...")
  widget_target = project.new_target(:app_extension, "HydroWidgets", :ios, "17.0")

  widget_group = project.main_group.find_subpath("HydroWidgets", true)
  widget_group.set_source_tree("<group>")
  widget_group.set_path("HydroWidgets")

  swift_file_1 = widget_group.new_file("HydroWidgets.swift")
  swift_file_2 = widget_group.new_file("AppIntents.swift")
  widget_group.new_file("Info.plist")

  widget_target.source_build_phase.add_file_reference(swift_file_1, true)
  widget_target.source_build_phase.add_file_reference(swift_file_2, true)

  ["WidgetKit", "SwiftUI", "AppIntents"].each do |fw_name|
    fw_ref = project.frameworks_group.new_reference("System/Library/Frameworks/#{fw_name}.framework")
    fw_ref.name = "#{fw_name}.framework"
    fw_ref.source_tree = "SDKROOT"
    build_file = widget_target.frameworks_build_phase.add_file_reference(fw_ref, true)
    if fw_name == "AppIntents"
      build_file.settings = { "ATTRIBUTES" => ["Weak"] }
    end
  end

  widget_target.build_configurations.each do |config|
    config.build_settings["PRODUCT_BUNDLE_IDENTIFIER"] = widget_bundle_id
    config.build_settings["PRODUCT_NAME"] = "$(TARGET_NAME)"
    config.build_settings["INFOPLIST_FILE"] = "HydroWidgets/Info.plist"
    config.build_settings["GENERATE_INFOPLIST_FILE"] = "NO"
    config.build_settings["SWIFT_VERSION"] = "5.0"
    config.build_settings["IPHONEOS_DEPLOYMENT_TARGET"] = "17.0"
    config.build_settings["TARGETED_DEVICE_FAMILY"] = "1,2"
    config.build_settings["SKIP_INSTALL"] = "YES"
    config.build_settings["CLANG_ENABLE_MODULES"] = "YES"
    config.build_settings["LD_RUNPATH_SEARCH_PATHS"] = "$(inherited) @executable_path/Frameworks @executable_path/../../Frameworks"
    config.build_settings["DEVELOPMENT_TEAM"] = team_id
    config.build_settings["CODE_SIGN_STYLE"] = "Manual"
    config.build_settings["CODE_SIGN_IDENTITY"] = "Apple Distribution"
    config.build_settings["PROVISIONING_PROFILE_SPECIFIER"] = widget_profile_name
  end

  runner_target.add_dependency(widget_target)

  embed_phase = runner_target.copy_files_build_phases.find { |p| p.name == "Embed Foundation Extensions" || p.dst_subfolder_spec == "13" }
  unless embed_phase
    embed_phase = runner_target.new_copy_files_build_phase("Embed Foundation Extensions")
    embed_phase.dst_subfolder_spec = "13"
  end

  appex_build_file = embed_phase.add_file_reference(widget_target.product_reference, true)
  appex_build_file.settings = { "ATTRIBUTES" => ["RemoveHeadersOnCopy"] }

  # Ensure Embed Foundation Extensions runs BEFORE Thin Binary script if Thin Binary exists
  thin_idx = runner_target.build_phases.index { |p| p.respond_to?(:name) && p.name == "Thin Binary" }
  embed_idx = runner_target.build_phases.index(embed_phase)
  if thin_idx && embed_idx && embed_idx > thin_idx
    runner_target.build_phases.delete(embed_phase)
    runner_target.build_phases.insert(thin_idx, embed_phase)
  end

  project.save
  UI.success("Successfully attached and configured HydroWidgets target in Runner.xcodeproj!")
end

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    keychain_name = "ci_keychain"
    keychain_password = "ci_password"

    create_keychain(
      name: keychain_name,
      password: keychain_password,
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    kc_path_db = File.expand_path("~/Library/Keychains/#{keychain_name}-db")
    kc_path_raw = File.expand_path("~/Library/Keychains/#{keychain_name}")
    kc_path = File.exist?(kc_path_db) ? kc_path_db : kc_path_raw

    # Always ensure clean, fresh and valid distribution certificate
    revoke_old_distribution_certs(
      ENV["APP_STORE_CONNECT_KEY_ID"],
      ENV["APP_STORE_CONNECT_ISSUER_ID"],
      ENV["APP_STORE_CONNECT_PRIVATE_KEY"]
    )
    get_certificates(
      keychain_path: kc_path,
      keychain_password: keychain_password,
      force: true
    )

    app_bundle_id = "com.antigravity.hydroreminder.hydroReminder"
    widget_bundle_id = "com.antigravity.hydroreminder.hydroReminder.HydroWidgets"

    ensure_bundle_id_exists(
      ENV["APP_STORE_CONNECT_KEY_ID"],
      ENV["APP_STORE_CONNECT_ISSUER_ID"],
      ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      app_bundle_id,
      "Hydro Reminder Su"
    )

    ensure_bundle_id_exists(
      ENV["APP_STORE_CONNECT_KEY_ID"],
      ENV["APP_STORE_CONNECT_ISSUER_ID"],
      ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      widget_bundle_id,
      "Hydro Reminder Widgets"
    )

    get_provisioning_profile(
      app_identifier: app_bundle_id,
      force: true
    )
    app_profile_name = Actions.lane_context[SharedValues::SIGH_NAME]

    get_provisioning_profile(
      app_identifier: widget_bundle_id,
      force: true
    )
    widget_profile_name = Actions.lane_context[SharedValues::SIGH_NAME]

    attach_widget_extension_to_xcodeproj(
      "BHYTLHA722",
      widget_bundle_id,
      widget_profile_name
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "Runner.xcodeproj",
      team_id: "BHYTLHA722",
      targets: ["Runner"],
      bundle_identifier: app_bundle_id,
      profile_name: app_profile_name,
      code_sign_identity: "Apple Distribution"
    )

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        method: "app-store",
        export_team_id: "BHYTLHA722",
        signingStyle: "manual",
        provisioningProfiles: {
          app_bundle_id => app_profile_name,
          widget_bundle_id => widget_profile_name
        }
      },
      xcargs: "DEVELOPMENT_TEAM=BHYTLHA722",
      output_directory: "./build_fastlane",
      output_name: "hydro_reminder.ipa"
    )

    upload_to_testflight(
      ipa: "./build_fastlane/hydro_reminder.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end

