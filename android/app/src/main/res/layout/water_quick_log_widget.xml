<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_quick_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <!-- Header / Streak + Mascot Status Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_quick_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:text="🔥 1 gün · ⚡ Hızlı Ekle"
            android:textColor="#FFFFFF"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tv_quick_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-bold"
            android:text="🥱 0 ml"
            android:textColor="#F1F5F9"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- 3 Quick Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Preset 1: Bardak -->
        <LinearLayout
            android:id="@+id/btn_quick_preset1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tv_quick_emoji1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥛"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_quick_preset1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="+200 ml"
                android:textColor="#0369A1"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Preset 2: Şişe -->
        <LinearLayout
            android:id="@+id/btn_quick_preset2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_marginRight="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tv_quick_emoji2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🥤"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_quick_preset2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="+330 ml"
                android:textColor="#0369A1"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Preset 3: Büyük Şişe -->
        <LinearLayout
            android:id="@+id/btn_quick_preset3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="3dp"
            android:layout_weight="1"
            android:background="@drawable/widget_button_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="2dp">

            <TextView
                android:id="@+id/tv_quick_emoji3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🫙"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tv_quick_preset3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="+500 ml"
                android:textColor="#0369A1"
                android:textSize="10sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
