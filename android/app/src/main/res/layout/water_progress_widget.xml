<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_progress_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="10dp"
    android:paddingRight="10dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Left Column: Streak, Callout, Progress Bar, 5-Day Checkmarks & Quick Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.25"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- Header Row: Streak Flame + Percentage Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_streak_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:text="🔥 1 gün"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:background="@drawable/widget_floating_pill_bg"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingLeft="6.5dp"
                android:paddingRight="6.5dp"
                android:paddingTop="1.5dp"
                android:paddingBottom="1.5dp"
                android:text="💧 %0"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Dynamic Mascot Callout Message -->
        <TextView
            android:id="@+id/tv_progress_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2.5dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0.5dp"
            android:maxLines="3"
            android:text="Çok susuz kaldın! Hemen bir bardak su al."
            android:textColor="#F1F5F9"
            android:textSize="10sp" />

        <!-- Live Water Progress Bar (Su Barı) -->
        <ProgressBar
            android:id="@+id/pb_water_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_marginTop="3.5dp"
            android:layout_marginRight="4dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/widget_progress_bar" />

        <!-- 5-Day Streak Checkmark Row (Pe Cu Ct Pa Pt) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4.5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Day 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_day_label_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="Pe"
                    android:textColor="#E2E8F0"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tv_day_check_1"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_day_circle_empty"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="•"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Day 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_day_label_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="Cu"
                    android:textColor="#E2E8F0"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tv_day_check_2"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_day_circle_empty"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="•"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Day 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_day_label_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="Ct"
                    android:textColor="#E2E8F0"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tv_day_check_3"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_day_circle_done"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="✓"
                    android:textColor="#0369A1"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Day 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_day_label_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="Pa"
                    android:textColor="#E2E8F0"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tv_day_check_4"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_day_circle_done"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="✓"
                    android:textColor="#0369A1"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Day 5 (Today) -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_day_label_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="Pt"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tv_day_check_5"
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_day_circle_empty"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:text="•"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick 1-Tap Action Pills -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_progress_preset1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginRight="4dp"
                android:background="@drawable/widget_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="3.5dp"
                android:paddingBottom="3.5dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="🥛 +200 ml"
                android:textColor="#0369A1"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/btn_progress_preset2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/widget_floating_pill_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:paddingTop="3.5dp"
                android:paddingBottom="3.5dp"
                android:singleLine="true"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="🥤 +330 ml"
                android:textColor="#FFFFFF"
                android:textSize="9.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Column: Full-Height Square Mascot Card (Duolingo / iOS Style) -->
    <FrameLayout
        android:id="@+id/fl_mascot_card_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.75"
        android:layout_marginLeft="8dp"
        android:layout_gravity="center">

        <!-- Full-Scale Square Mascot Image with scaleType="fitCenter" -->
        <ImageView
            android:id="@+id/iv_mascot_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:scaleType="fitCenter"
            android:visibility="visible" />
            android:layout_gravity="center"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:visibility="visible" />

        <!-- Fallback Mascot Emoji if image is not loaded -->
        <TextView
            android:id="@+id/tv_mascot_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:includeFontPadding="false"
            android:text="🥱"
            android:textSize="44sp"
            android:visibility="gone" />

        <!-- Floating Bottom Info Pill (Current / Daily Goal) -->
        <TextView
            android:id="@+id/tv_progress_consumed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="4dp"
            android:background="@drawable/widget_floating_pill_bg"
            android:fontFamily="sans-serif-black"
            android:includeFontPadding="false"
            android:paddingLeft="7dp"
            android:paddingRight="7dp"
            android:paddingTop="2.5dp"
            android:paddingBottom="2.5dp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"
            android:text="0 / 2500 ml"
            android:textColor="#FFFFFF"
            android:textSize="9.5sp" />
    </FrameLayout>

</LinearLayout>
