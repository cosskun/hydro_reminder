<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_progress_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="14dp"
    android:paddingRight="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <!-- Left Column: Streak, Callout, 5-Day Checkmarks & Quick Buttons -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Header Row: Streak Flame + Percentage Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_streak_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="🔥 1 gün"
                android:textColor="#FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tv_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="8dp"
                android:background="@drawable/widget_mascot_stage_bg"
                android:fontFamily="sans-serif-black"
                android:paddingLeft="7dp"
                android:paddingRight="7dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="💧 %0"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Dynamic Mascot Callout Message -->
        <TextView
            android:id="@+id/tv_progress_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:text="Damla seni çağırıyor! Su içelim! 💦"
            android:textColor="#F1F5F9"
            android:textSize="11.5sp" />

        <!-- 5-Day Duolingo Checkmark Row (Pe Cu Ct Pa Pt) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Day 1 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_day_label_1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Pe"
                    android:textColor="#E2E8F0"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tv_day_check_1"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_day_circle_empty"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="•"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Day 2 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_day_label_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Cu"
                    android:textColor="#E2E8F0"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tv_day_check_2"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_day_circle_empty"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="•"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Day 3 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_day_label_3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Ct"
                    android:textColor="#E2E8F0"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tv_day_check_3"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_day_circle_done"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#0369A1"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Day 4 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="6dp"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_day_label_4"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Pa"
                    android:textColor="#E2E8F0"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tv_day_check_4"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_day_circle_done"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#0369A1"
                    android:textSize="10sp" />
            </LinearLayout>

            <!-- Day 5 (Today) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/tv_day_label_5"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-bold"
                    android:text="Pt"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
                <TextView
                    android:id="@+id/tv_day_check_5"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="2dp"
                    android:background="@drawable/widget_day_circle_empty"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:text="•"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quick 1-Tap Action Pills -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_progress_preset1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/widget_button_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-black"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="🥛 +200 ml"
                android:textColor="#0369A1"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/btn_progress_preset2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:background="@drawable/widget_mascot_stage_bg"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-black"
                android:paddingLeft="8dp"
                android:paddingRight="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="🥤 +330 ml"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Right Column: Mascot Character Stage (Duolingo Duo Style) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="8dp"
        android:gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/widget_mascot_stage_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">

            <TextView
                android:id="@+id/tv_mascot_emoji"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="🥵"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/tv_progress_consumed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:text="0 ml"
                android:textColor="#FFFFFF"
                android:textSize="10.5sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_progress_goal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="sans-serif-bold"
            android:text="Hedef: 2500 ml"
            android:textColor="#E2E8F0"
            android:textSize="9.5sp" />
    </LinearLayout>

</LinearLayout>
