default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_PRIVATE_KEY"],
      is_key_content_base64: false
    )

    # Otomatik App ID ve App Store Connect kaydi
    produce(
      api_key: api_key,
      app_identifier: "com.antigravity.hydroreminder.hydroReminder",
      app_name: "Hydro Reminder",
      language: "Turkish"
    )

    # Gecici Keychain olustur
    create_keychain(
      name: "ci_keychain",
      password: "ci_password",
      default_keychain: true,
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false
    )

    # Sertifika ve Provisioning Profile indir / uret
    get_certificates(
      api_key: api_key,
      keychain_name: "ci_keychain",
      keychain_password: "ci_password",
      development: false
    )

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: "com.antigravity.hydroreminder.hydroReminder",
      development: false
    )

    # IPA Derle
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      clean: true,
      output_directory: "./build_fastlane",
      output_name: "HydroReminder.ipa"
    )

    # TestFlight'a Gonder
    upload_to_testflight(
      api_key: api_key,
      ipa: "./build_fastlane/HydroReminder.ipa",
      skip_waiting_for_build_processing: true
    )
  end
end
